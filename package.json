{
  "name": "keyboard-warrior",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KEYBOARD WARRIOR — Cyberpunk Typing Arcade Game for KNI Open Day",
  "scripts": {
    "dev": "vite",
